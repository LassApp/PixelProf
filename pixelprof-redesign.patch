+   illeggibili quando il contenitore diventa chiaro nel tema light). */
+.dp-hint-text{ font-size:11px;color:rgba(255,255,255,.3); }
+}
+
+@layer theme {
+/* ── 18. GESTIONE DOCENTI / DASHBOARD DIRETTORE ──────────────── */
+html[data-theme="light"] #screen-director-dashboard,html[data-theme="light"] #screen-teacher-mgmt,
