diff --git a/css/docenti.css b/css/docenti.css
new file mode 100644
index 0000000..8109b03
--- /dev/null
+++ b/css/docenti.css
@@ -0,0 +1,191 @@
+/* ===============================================
+   GESTIONE DOCENTI / DASHBOARD DIRETTORE
+   Estratto dal monolite pixelprof.css (redesign palette v9).
+   NOTA: l'override tema chiaro per questa sezione resta per ora
+   nel grande blocco @layer theme condiviso in pixelprof.css
+   (sezione numerata corrispondente — vedi commento lì) e non è
+   stato ancora spostato qui: la separazione dell'override chiaro
+   sezione-per-sezione è un passo successivo, non incluso in questa
+   estrazione.
+=============================================== */
+@layer docenti {
+   PixelProf v6.1.0 — REDESIGN GESTIONE DOCENTI
+   Hub a 2 card (riusa .dd-grid/.dd-card già esistenti) + schermata
+   creazione + lista a card con tab + dettaglio con gestione aule.
+   .tm-list/.tm-row* sopra restano definiti ma non più referenziati
+   (vecchio design) — lasciati per zero rischio, nessun conflitto.
+   ═══════════════════════════════════════════════════════════════════ */
+
+/* ── Hub: variante a 2 card di .dd-grid ── */
+.dd-grid-2{ grid-template-columns:1fr; }
+@media(min-width:480px){ .dd-grid-2{ grid-template-columns:1fr 1fr; } }
+.dd-new-teacher{ border-color:rgba(var(--accent-rgb),.15); }
+.dd-new-teacher::after{ background:linear-gradient(90deg,transparent,var(--accent),transparent); }
+.dd-new-teacher:hover{ border-color:rgba(var(--accent-rgb),.5); box-shadow:0 12px 36px rgba(var(--accent-rgb),.14); }
+.dd-new-teacher:hover .dd-title,.dd-new-teacher:hover .dd-arrow{ color:var(--accent); }
+
+/* v6.1.1 FIX: .dd-teacher-list non aveva alcuna regola di accento —
+   il bordo/bottom-bar restava trasparente (nessun background sul
+   ::after ereditato da .dd-card), quindi la card "Docenti" non si
+   illuminava al hover come "Nuovo Docente". Stessa palette violetta
+   già usata per .dd-docenti nella Dashboard Direttore. */
+.dd-teacher-list{ border-color:rgba(var(--purple-rgb),.15); }
+.dd-teacher-list::after{ background:linear-gradient(90deg,transparent,var(--purple),transparent); }
+.dd-teacher-list:hover{ border-color:rgba(var(--purple-rgb),.5); box-shadow:0 12px 36px rgba(var(--purple-rgb),.14); }
+.dd-teacher-list:hover .dd-title,.dd-teacher-list:hover .dd-arrow{ color:#b4a0ff; }
+
+/* ── Toggle Genere (creazione + dettaglio) ── */
+.gender-toggle{ display:flex; gap:8px; }
+.gender-btn{
+  flex:1;padding:10px;border-radius:var(--radius-sm);border:1px solid var(--border-mid);
+  background:var(--surface-1);cursor:pointer;font-size:13px;font-weight:600;
+  color:rgba(255,255,255,.55);display:flex;align-items:center;justify-content:center;gap:6px;
+  font-family:inherit;transition:all var(--transition-fast);
+}
+.gender-btn i{ font-size:16px; }
+.gender-btn:hover{ border-color:var(--accent-border); color:var(--accent); background:var(--accent-dim); }
+.gender-btn.active{ border:1.5px solid var(--accent); background:rgba(var(--accent-rgb),.14); color:var(--accent); font-weight:700; }
+
+/* ── Tabs Attivi / Disattivati (lista docenti) ── */
+.tm-tabs{ display:flex; gap:4px; margin-bottom:18px; border-bottom:1px solid rgba(255,255,255,.08); }
+.tm-tab{
+  padding:9px 16px;border:none;background:none;cursor:pointer;
+  font-family:inherit;font-size:12px;font-weight:700;letter-spacing:.3px;
+  color:rgba(255,255,255,.4);border-bottom:2px solid transparent;
+  transition:color .18s,border-color .18s;
+}
+.tm-tab:hover{ color:rgba(255,255,255,.75); }
+.tm-tab.active{ color:var(--accent); border-bottom-color:var(--accent); }
+
+/* ── Griglia card docente (lista) ── */
+.tdc-grid{ display:grid;grid-template-columns:1fr;gap:10px; }
+@media(min-width:600px){ .tdc-grid{ grid-template-columns:1fr 1fr; } }
+
+.tdc-card{
+  position:relative;border-radius:14px;overflow:hidden;
+  border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.035);
+  padding:14px 16px;cursor:pointer;
+  transition:transform .2s cubic-bezier(.34,1.56,.64,1),border-color .2s,background .2s,box-shadow .2s;
+  box-shadow:0 4px 16px rgba(0,0,0,.3);
+}
+/* v6.1.1 FIX: mancava la bottom accent bar presente su tutte le altre
+   card dell'app (.dd-card, .course-card, .cat-card) — la card docente
+   non si "illuminava" al hover come le altre. Colore semantico: verde
+   per i docenti attivi, rosso per i disattivati (stessa palette di
+   .tdc-status-dot). */
+.tdc-card::after{
+  content:'';position:absolute;bottom:0;left:0;right:0;height:2px;
+  background:#00ff96;transform:scaleX(0);transform-origin:left;
+  transition:transform .2s cubic-bezier(.34,1.56,.64,1);
+}
+.tdc-card:hover::after{ transform:scaleX(1); }
+.tdc-card.tdc-inactive::after{ background:#ff4d6d; }
+.tdc-card:hover{ transform:translateY(-3px); border-color:rgba(var(--accent-rgb),.3); background:rgba(var(--accent-rgb),.04); box-shadow:0 10px 28px rgba(0,0,0,.4); }
+.tdc-card:focus-visible{ outline:2px solid var(--accent); outline-offset:2px; }
+.tdc-card.tdc-inactive{ opacity:.55; }
+.tdc-card.tdc-inactive:hover{ opacity:.75; }
+/* v8.15.2: .tdc-card.tdc-inactive{opacity:.55} moltiplica il colore di TUTTI i
+   figli (stesso pattern già risolto per .bdg-card.locked/.bdg-desc in v8.13.1).
+   var(--text-muted) 4.51:1 × .55 = ~2.48:1, var(--text-dim) 3.04:1 × .55 = ~1.67:1
+   — entrambi sotto ogni soglia AA. Override scoped solo al contesto disattivato,
+   per non alterare (né oscurare eccessivamente) lo stato attivo. */
+.tdc-card.tdc-inactive .tdc-email,
+.tdc-card.tdc-inactive .tdc-aula-chip,
+.tdc-card.tdc-inactive .tdc-aule-empty{ color: rgba(255,255,255,.72); } /* effettivo ×.55 ≈ .396, sopra soglia --text-dim (.34) */
+
+.tdc-header{ display:flex;align-items:center;gap:10px;margin-bottom:10px; }
+.tdc-gender-icon{
+  width:32px;height:32px;border-radius:50%;flex-shrink:0;
+  display:flex;align-items:center;justify-content:center;font-size:15px;
+  background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);color:rgba(255,255,255,.45);
+}
+.tdc-gender-icon.g-uomo{ background:rgba(30,144,255,.12);border-color:rgba(30,144,255,.3);color:#5eb0ff; }
+.tdc-gender-icon.g-donna{ background:rgba(255,77,109,.12);border-color:rgba(255,77,109,.3);color:#ff8fa3; }
+.tdc-name{ flex:1;font-size:14px;font-weight:700;color:#fff;overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }
+.tdc-status-dot{ width:9px;height:9px;border-radius:50%;flex-shrink:0;box-shadow:0 0 6px currentColor; }
+.tdc-status-dot.active{ background:#00ff96;color:#00ff96; }
+.tdc-status-dot.inactive{ background:#ff4d6d;color:#ff4d6d; }
+
+.tdc-email{ font-size:11px;color:var(--text-muted);margin-bottom:10px;font-family:'Share Tech Mono',monospace;overflow:hidden;text-overflow:ellipsis;white-space:nowrap; } /* v8.15.2 FIX: era rgba(255,255,255,.4) ~3.78:1 in scuro -> ora var(--text-muted), AA piena e già tematizzato */
+
+.tdc-aule-row{ border-top:1px solid rgba(255,255,255,.06);padding-top:9px;display:flex;flex-wrap:wrap;line-height:1.6; }
+.tdc-aula-chip{ font-size:10px;font-weight:500;color:var(--text-muted);font-family:'Share Tech Mono',monospace;white-space:nowrap; } /* v8.15.2 FIX: era rgba(255,255,255,.45) */
+.tdc-aula-chip + .tdc-aula-chip::before{ content:' | ';color:rgba(255,255,255,.18);white-space:pre; } /* separatore puramente decorativo, non testo informativo — non soggetto a soglie AA */
+.tdc-aule-empty{ font-size:10px;color:var(--text-dim);font-style:italic; } /* v8.15.2 FIX: era rgba(255,255,255,.2) ~1.5:1 */
+
+/* ── Toggle aule (scheda dettaglio docente) ── */
+.tdc-aule-toggle-grid{ display:flex;flex-wrap:wrap;gap:7px; }
+.tdc-aula-toggle-btn{
+  padding:6px 14px;border-radius:20px;border:1px solid var(--border-mid);
+  background:var(--surface-1);font-size:12px;cursor:pointer;
+  color:rgba(255,255,255,.5);font-family:inherit;font-weight:600;
+  transition:all var(--transition-fast);display:inline-flex;align-items:center;gap:5px;
+}
+.tdc-aula-toggle-btn:hover{ border-color:rgba(var(--accent-rgb),.3);color:rgba(255,255,255,.8); }
+.tdc-aula-toggle-btn.active{ background:rgba(var(--accent-rgb),.12);border-color:var(--accent);color:var(--accent); }
+.tdc-aula-toggle-btn:disabled{ opacity:.4;cursor:default; }
+
+/* .tmd-email-hint — riga "Email attuale: ..." nella scheda docente
+   (screen-teacher-detail). v6.6: estratta dallo stile inline in
+   index.html per poterla tematizzare correttamente. */
