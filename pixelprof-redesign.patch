diff --git a/css/audio.css b/css/audio.css
new file mode 100644
index 0000000..10db918
--- /dev/null
+++ b/css/audio.css
@@ -0,0 +1,54 @@
+/* ===============================================
+   TOGGLE AUDIO/TEMA
+   Estratto dal monolite pixelprof.css (redesign palette v9).
+   NOTA: l'override tema chiaro per questa sezione resta per ora
+   nel grande blocco @layer theme condiviso in pixelprof.css
+   (sezione numerata corrispondente — vedi commento lì) e non è
+   stato ancora spostato qui: la separazione dell'override chiaro
+   sezione-per-sezione è un passo successivo, non incluso in questa
+   estrazione.
+=============================================== */
+@layer audio {
+/* ═══════════════════════════════════════════════════════════════════
+   PixelProf v6.5.0 — FEEDBACK SONORO + TOGGLE AUDIO
+   Pulsante toggle (icona altoparlante) — visibile SOLO nella
+   schermata "Seleziona aula" (screen-courses) e nello step
+   "Seleziona modulo" (step-mod) della home, come richiesto: lo
+   stato impostato da qui vale per l'intera webapp (gestito da
+   js/audio-manager.js, persistito in localStorage).
+   ═══════════════════════════════════════════════════════════════════ */
+
+.audio-toggle-btn{
+  display:inline-flex;align-items:center;justify-content:center;
+  width:30px;height:30px;border-radius:50%;flex-shrink:0;
+  border:1px solid rgba(255,255,255,.14);
+  background:rgba(255,255,255,.05);
+  color:rgba(255,255,255,.55);
+  cursor:pointer;font-family:inherit;font-size:14px;
+  transition:all var(--transition-fast);
+}
+.audio-toggle-btn:hover{
+  border-color:rgba(var(--accent-rgb),.35);
+  background:rgba(var(--accent-rgb),.08);
+  color:var(--accent);
+}
+.audio-toggle-btn .audio-toggle-icon{font-size:15px;line-height:1}
+.audio-toggle-btn.muted{
+  color:rgba(255,120,120,.65);
+  border-color:rgba(255,80,80,.22);
+  background:rgba(255,80,80,.05);
+}
+.audio-toggle-btn.muted:hover{
+  border-color:rgba(255,80,80,.4);
+  background:rgba(255,80,80,.1);
+  color:#ff6b6b;
+}
+}
+
+@layer theme {
+/* ── 20. TOGGLE AUDIO/TEMA ────────────────────────────────────── */
+html[data-theme="light"] .audio-toggle-btn{ border-color: rgba(var(--navy-rgb),.14); background: rgba(var(--navy-rgb),.04); color: rgba(var(--navy-rgb),.55); }
+html[data-theme="light"] .audio-toggle-btn:hover{ border-color: rgba(var(--accent-rgb),.35); background: rgba(var(--accent-rgb),.08); color: var(--accent); }
+html[data-theme="light"] .theme-toggle-btn.is-light{ color:#a66d00; border-color: rgba(180,130,0,.3); background: rgba(255,180,0,.08); }
+
+}
diff --git a/css/classhealth.css b/css/classhealth.css
new file mode 100644
index 0000000..7d05f3e
--- /dev/null
+++ b/css/classhealth.css
@@ -0,0 +1,250 @@
+/* ===============================================
+   PANORAMICA SALUTE CLASSE (classhealth)
+   Estratto dal monolite pixelprof.css (redesign palette v9).
+   NOTA: l'override tema chiaro per questa sezione resta per ora
+   nel grande blocco @layer theme condiviso in pixelprof.css
+   (sezione numerata corrispondente — vedi commento lì) e non è
+   stato ancora spostato qui: la separazione dell'override chiaro
+   sezione-per-sezione è un passo successivo, non incluso in questa
+   estrazione.
+=============================================== */
+@layer classhealth {
+/* ═══════════════════════════════════════════════════════════════════
+   PixelProf — PANORAMICA CLASSE (dashboard.js)
+   Dashboard aggregata per il docente: accuratezza, modulo più debole,
+   partecipazione, attività più giocate. Nuove classi (prefisso chd-,
+   storico per "class health" — mantenuto invariato per non rompere
+   selettori esistenti), nessuna collisione con layer esistenti —
+   dichiarato per ultimo per coerenza con la regola "nuova feature →
+   nuovo layer in fondo".
+   ═══════════════════════════════════════════════════════════════════ */
+
+/* ── KPI hero row ── */
+.chd-kpi-grid{
+  display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:1.1rem;
+}
+.chd-kpi-card{
+  background:var(--surface-1);border:1px solid var(--border-subtle);
+  border-radius:var(--radius-md);padding:14px 10px;text-align:center;
+  transition:all var(--transition-fast);position:relative;overflow:hidden;
+  box-shadow:var(--shadow-card);
+}
+.chd-kpi-card::after{
+  content:'';position:absolute;bottom:0;left:0;right:0;height:2px;
+  background:var(--accent);transform:scaleX(0);transition:transform var(--transition-fast);
+}
+.chd-kpi-card:hover{background:var(--surface-2);border-color:rgba(var(--accent-rgb),.2);}
+.chd-kpi-card:hover::after{transform:scaleX(1);}
+.chd-kpi-icon{font-size:20px;margin-bottom:4px;line-height:1}
+.chd-kpi-val{font-size:21px;font-weight:700;color:var(--accent);font-family:'Share Tech Mono',monospace;line-height:1.15}
+.chd-kpi-lbl{font-size:10px;color:rgba(255,255,255,.4);margin-top:4px;line-height:1.3}
+
+/* ── Sezione generica ── */
+.chd-section{margin-bottom:1.25rem}
+.chd-section-title{
+  font-size:13px;font-weight:700;color:#fff;margin-bottom:10px;
+  display:flex;align-items:center;gap:8px;
+}
+
+/* ── Card "modulo più debole" ── */
+.chd-weak-card{
+  background:rgba(255,255,255,.03);border:1px solid var(--border-subtle);
+  border-radius:var(--radius-md);padding:14px 16px;
+}
+.chd-weak-headline{font-size:13px;color:rgba(255,255,255,.7);margin-bottom:14px;line-height:1.5;font-weight:500}
+.chd-mod-row{margin-bottom:10px}
+.chd-mod-row:last-child{margin-bottom:0}
+.chd-mod-row-top{display:flex;align-items:center;gap:7px;margin-bottom:5px;font-size:12px}
+.chd-mod-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;box-shadow:0 0 5px currentColor}
+.chd-mod-name{flex:1;color:rgba(255,255,255,.65);font-weight:500}
+.chd-mod-pct{font-family:'Share Tech Mono',monospace;font-weight:700;font-size:12px}
+.chd-mod-nodata{opacity:.4}
+
+/* ── Tabella partecipazione ── */
+.chd-part-table{
+  background:rgba(255,255,255,.03);border:1px solid var(--border-subtle);
+  border-radius:var(--radius-md);overflow:hidden;
+}
+.chd-part-row{
+  display:grid;grid-template-columns:1fr 72px 64px 84px;align-items:center;gap:6px;
+  padding:9px 14px;font-size:12px;color:rgba(255,255,255,.75);
+  border-bottom:1px solid rgba(255,255,255,.05);
+}
+.chd-part-row:last-child{border-bottom:none}
+.chd-part-header{
+  font-size:9px;font-weight:700;color:rgba(255,255,255,.3);text-transform:uppercase;
+  letter-spacing:.6px;background:rgba(255,255,255,.02);
+}
+.chd-part-name{display:flex;align-items:center;gap:6px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.chd-type-icon{font-size:11px;flex-shrink:0}
+.chd-color-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0}
+.chd-part-sessions,.chd-part-avg{text-align:center;font-family:'Share Tech Mono',monospace}
+.chd-part-last{text-align:right;color:rgba(255,255,255,.4);font-size:10px;white-space:nowrap}
+
+/* ── Banner "non ha mai giocato" ── */
+.chd-never-played{
+  display:flex;align-items:flex-start;gap:8px;margin-top:10px;
+  padding:10px 14px;border-radius:10px;
+  background:rgba(255,180,0,.08);border:1px solid rgba(255,180,0,.22);
+  color:#ffb400;font-size:11px;line-height:1.5;
+}
+.chd-never-played i{font-size:14px;flex-shrink:0;margin-top:1px}
+
+/* ── Attività più giocate ── */
+.chd-act-list{display:flex;flex-direction:column;gap:8px}
+.chd-act-row{display:flex;align-items:center;gap:10px;font-size:12px}
+.chd-act-icon{font-size:16px;flex-shrink:0;width:20px;text-align:center}
+.chd-act-name{width:108px;flex-shrink:0;color:rgba(255,255,255,.65);font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.chd-act-bar-wrap{flex:1;height:6px;border-radius:3px;background:rgba(255,255,255,.06);overflow:hidden}
+.chd-act-bar{height:100%;border-radius:3px;background:linear-gradient(90deg,var(--accent),var(--purple))}
+.chd-act-count{width:24px;flex-shrink:0;text-align:right;font-family:'Share Tech Mono',monospace;font-weight:700;color:var(--accent)}
+
+/* ── Empty state ── */
+.chd-empty{text-align:center;padding:3rem 1rem}
+.chd-empty-icon{font-size:40px;margin-bottom:14px;opacity:.4}
+.chd-empty-title{font-size:14px;font-weight:600;color:var(--text-muted);margin-bottom:6px} /* v8.15.1 FIX: era rgba(255,255,255,.35) ~3.1:1 in scuro -> ora var(--text-muted), stesso pattern di .lb-empty .le-title (v8.13.1) */
+.chd-empty-sub{font-size:12px;color:var(--text-dim);max-width:280px;margin:0 auto;line-height:1.5} /* v8.15.1 FIX: era rgba(255,255,255,.2) ~1.8:1, quasi invisibile -> ora var(--text-dim), stesso pattern di .lb-empty .le-sub (v8.13.1) */
+
+/* ── Footnote ── */
+.chd-footnote{
+  display:flex;align-items:flex-start;gap:6px;margin-top:.5rem;
+  font-size:10px;color:var(--text-dim);line-height:1.5; /* v8.13.1 FIX: era .25 = 2.16:1 */
+}
+.chd-footnote i{flex-shrink:0;margin-top:1px;font-size:12px}
+
+/* ── Responsive ── */
+@media(max-width:420px){
+  .chd-kpi-grid{grid-template-columns:1fr;}
+  .chd-part-row{grid-template-columns:1fr 56px 50px;}
+  .chd-part-last{display:none;}
+  .chd-act-name{width:84px;}
+}
+
+/* Tabs Problematiche / Recuperate — stesso pattern di .tm-tabs/.tm-tab
+   (Gestione Docenti), qui con accento cromatico rosso/verde coerente
+   col resto della sezione. */
+.chd-wq-tabs{
+  display:flex;gap:4px;margin-bottom:12px;
+  border-bottom:1px solid rgba(255,255,255,.08);
+}
+.chd-wq-tab{
+  display:flex;align-items:center;gap:6px;
+  padding:8px 14px;border:none;background:none;cursor:pointer;
+  font-family:inherit;font-size:12px;font-weight:700;letter-spacing:.2px;
+  color:var(--text-muted);border-bottom:2px solid transparent; /* v8.14.0 FIX: era rgba(255,255,255,.4) hardcoded = 3.78:1 scuro, 2.88:1 chiaro (duplicato sotto ignorava il token) */
+  transition:color .18s,border-color .18s;
+}
+.chd-wq-tab:hover{color:rgba(255,255,255,.75);}
+.chd-wq-tab-problem.active{color:#ff6b85;border-bottom-color:#ff4d6d;}
+.chd-wq-tab-recovered.active{color:#00ff96;border-bottom-color:#00ff96;}
+.chd-wq-tab-count{
+  font-size:9px;font-weight:700;padding:1px 6px;border-radius:20px;
+  background:rgba(255,255,255,.08);color:rgba(255,255,255,.5);
+  font-family:'Share Tech Mono',monospace;transition:all .18s;
+}
+.chd-wq-tab.active .chd-wq-tab-count{background:rgba(255,255,255,.14);color:inherit;}
+
+/* Sotto-filtro modulo — chip colorate, nomi estesi (un docente non
+   deve sapere a memoria cosa significano le sigle CE/OE/WP). Colore
+   per modulo allineato a _CHD_MOD_COLOR, la stessa palette già usata
+   sopra in questa dashboard per "Modulo più debole". */
+.chd-wq-modfilter{
+  display:flex;flex-wrap:wrap;gap:6px;margin-bottom:14px;
+}
+.chd-wq-modfilter-btn{
+  --chd-wq-mf-color:var(--accent);
+  display:inline-flex;align-items:center;gap:5px;
+  padding:5px 12px;border-radius:20px;
+  border:1px solid var(--border-mid);background:var(--surface-1);
+  color:rgba(255,255,255,.5);font-size:11px;font-weight:600;
+  cursor:pointer;font-family:inherit;transition:all var(--transition-fast);
+}
+.chd-wq-modfilter-btn:hover{border-color:var(--chd-wq-mf-color);color:var(--chd-wq-mf-color);}
+.chd-wq-modfilter-btn.active{
+  background:color-mix(in srgb, var(--chd-wq-mf-color) 14%, transparent);
+  border-color:var(--chd-wq-mf-color);color:var(--chd-wq-mf-color);
+}
+.chd-wq-modfilter-count{
+  font-size:9px;font-weight:700;padding:0 5px;border-radius:20px;
+  background:rgba(255,255,255,.1);font-family:'Share Tech Mono',monospace;
+}
+.chd-wq-modfilter-btn.active .chd-wq-modfilter-count{background:color-mix(in srgb, var(--chd-wq-mf-color) 25%, transparent);}
+
+.chd-wq-list{display:flex;flex-direction:column;gap:8px;}
+.chd-wq-row{
+  background:rgba(255,255,255,.03);
+  border:1px solid rgba(255,60,80,.18);
+  border-radius:var(--radius-md);
+  padding:12px 14px;
+  transition:border-color var(--transition-fast),background var(--transition-fast);
+  position:relative;overflow:hidden;
+}
+.chd-wq-row::before{
+  content:'';position:absolute;left:0;top:0;bottom:0;width:2px;
+  background:#ff4d6d;border-radius:2px 0 0 2px;
+}
+.chd-wq-row:hover{background:rgba(255,60,80,.04);border-color:rgba(255,60,80,.32);}
+/* Modifier a livello di lista (non più per-riga): tutte le righe della
+   tab "Recuperate" condividono l'accento verde — un'unica sostituzione
+   di outerHTML su #chd-wq-section aggiorna tab+filtro+lista insieme. */
+.chd-wq-list-recovered .chd-wq-row{border-color:rgba(0,255,150,.2);}
+.chd-wq-list-recovered .chd-wq-row::before{background:#00ff96;}
+.chd-wq-list-recovered .chd-wq-row:hover{background:rgba(0,255,150,.03);border-color:rgba(0,255,150,.35);}
+.chd-wq-list-recovered .chd-wq-bar{background:linear-gradient(90deg,#00ff96,#00cfff);}
+.chd-wq-header{
+  display:flex;align-items:center;gap:7px;margin-bottom:6px;flex-wrap:wrap;
+}
+.chd-wq-act-icon{font-size:13px;flex-shrink:0;}
+.chd-wq-errs{
+  margin-left:auto;font-size:10px;font-weight:700;
+  color:rgba(255,80,80,.9);font-family:'Share Tech Mono',monospace; /* v8.14.0 FIX: era .8 = 4.02:1 -> ora 4.82:1 */
+  flex-shrink:0;
+}
+.chd-wq-list-recovered .chd-wq-errs{color:rgba(0,255,150,.8);}
+.chd-wq-question{
+  font-size:13px;font-weight:500;color:rgba(255,255,255,.8);
+  line-height:1.45;margin-bottom:4px;
+}
+.chd-wq-answer{
+  font-size:11px;color:rgba(255,255,255,.4);margin-bottom:8px;
+}
+.chd-wq-answer strong{color:rgba(var(--accent-rgb),.75);}
+.chd-wq-bar-wrap{height:3px;border-radius:2px;background:rgba(255,255,255,.06);overflow:hidden;}
+.chd-wq-bar{height:100%;border-radius:2px;background:linear-gradient(90deg,#ff4d6d,#ff8080);}
+
+/* Stato vuoto per tab/filtro — stesso linguaggio visivo di .lb-empty/.chd-empty */
+.chd-wq-empty{
+  text-align:center;padding:2rem 1rem;
+  border:1px dashed rgba(255,255,255,.08);border-radius:var(--radius-md);
+}
+.chd-wq-empty-icon{font-size:30px;margin-bottom:10px;opacity:.6;}
+.chd-wq-empty-title{font-size:13px;font-weight:600;color:rgba(255,255,255,.5);margin-bottom:4px;}
+.chd-wq-empty-sub{font-size:11px;color:var(--text-dim);line-height:1.5;max-width:320px;margin:0 auto;} /* v8.14.0 FIX: era rgba(255,255,255,.25) = 2.16:1, sfuggito al giro Fase 2 */
+
+.chd-wq-reset-btn{
+  display:inline-flex;align-items:center;gap:4px;
+  padding:4px 10px;border-radius:7px;
+  background:rgba(255,80,80,.06);border:1px solid rgba(255,80,80,.2);
+  color:rgba(255,100,100,.85);font-size:10px;cursor:pointer;font-family:inherit; /* v8.14.0 FIX: era .6 = 3.03:1 -> ora 4.94:1 */
+  transition:all var(--transition-fast);font-weight:600;
+}
+.chd-wq-reset-btn:hover{background:rgba(255,80,80,.14);color:#ff6b6b;border-color:rgba(255,80,80,.4);}
+
+/* Mostra tutte / mostra solo le prime N — sostituisce la vecchia
+   .chd-wq-more statica con un vero toggle cliccabile. */
+.chd-wq-showall-btn{
+  display:flex;align-items:center;justify-content:center;gap:5px;
+  width:100%;margin-top:10px;padding:8px;border-radius:8px;
+  background:var(--surface-1);border:1px solid var(--border-subtle);
+  color:var(--text-muted);font-size:11px;font-weight:600;cursor:pointer; /* v8.13.1 FIX: era hardcoded bianco, illeggibile in chiaro */
+  font-family:inherit;transition:all var(--transition-fast);
+}
+.chd-wq-showall-btn:hover{background:var(--accent-dim);border-color:var(--accent-border);color:var(--accent);}
+.chd-wq-showall-btn i{font-size:13px;}
+
+@media(max-width:420px){
+  .chd-wq-question{font-size:12px;}
+  .chd-wq-errs{margin-left:0;}
+  .chd-wq-modfilter-btn{padding:5px 9px;font-size:10px;}
+}
+}
diff --git a/css/csvimport.css b/css/csvimport.css
new file mode 100644
index 0000000..e81603a
--- /dev/null
+++ b/css/csvimport.css
@@ -0,0 +1,99 @@
+/* ===============================================
+   IMPORT CSV
+   Estratto dal monolite pixelprof.css (redesign palette v9).
+   NOTA: l'override tema chiaro per questa sezione resta per ora
+   nel grande blocco @layer theme condiviso in pixelprof.css
+   (sezione numerata corrispondente — vedi commento lì) e non è
+   stato ancora spostato qui: la separazione dell'override chiaro
+   sezione-per-sezione è un passo successivo, non incluso in questa
+   estrazione.
+=============================================== */
+@layer csvimport {
+/* ═══════════════════════════════════════════════════════════════════
+   PixelProf — IMPORT GIOCATORI DA CSV (csv-import.js)
+   Pulsante trigger in #ps-ind + modal di anteprima pre-conferma.
+   Il modal riusa la struttura .pp-generic-overlay/.pp-generic-box
+   (game-engine-state.js — stesso sistema di ppAlert/ppConfirmBox):
+   nessun nuovo overlay/animazione da mantenere, solo classi per il
+   contenuto interno. Nuove classi, nessuna collisione con layer
+   esistenti — dichiarato per ultimo per coerenza con la regola
+   "nuova feature → nuovo layer in fondo" (vedi intestazione file).
+   ═══════════════════════════════════════════════════════════════════ */
+
+/* Pulsante trigger — stile "dropzone" tratteggiato, secondario
+   rispetto al pulsante neon pieno di aggiunta manuale sopra. */
+.csv-import-trigger-btn{
+  display:flex;align-items:center;justify-content:center;gap:7px;
+  width:100%;padding:9px;
+  border-radius:var(--radius-sm);
+  border:1px dashed rgba(var(--accent-rgb),.28);
+  background:rgba(var(--accent-rgb),.04);
+  color:rgba(var(--accent-rgb),.75);
+  font-size:12px;font-weight:600;font-family:inherit;
+  cursor:pointer;transition:all var(--transition-fast);
+}
+.csv-import-trigger-btn:hover{
+  background:rgba(var(--accent-rgb),.09);
+  border-color:rgba(var(--accent-rgb),.5);
+  color:var(--accent);
+}
+.csv-import-trigger-btn i{font-size:15px}
+
+/* Nota duplicati esclusi automaticamente — dentro il modal anteprima */
+.csv-import-dupnote{
+  display:flex;align-items:flex-start;gap:6px;
+  font-size:11px;color:rgba(255,180,0,.85);line-height:1.5;
+  background:rgba(255,180,0,.07);border:1px solid rgba(255,180,0,.2);
+  border-radius:8px;padding:8px 10px;margin-bottom:12px;text-align:left;
+}
+.csv-import-dupnote i{font-size:13px;flex-shrink:0;margin-top:1px}
+
+/* Elenco scrollabile dei nominativi da importare — righe rimovibili */
+.csv-import-list{
+  max-height:220px;overflow-y:auto;
+  border:1px solid var(--border-subtle);border-radius:var(--radius-sm);
+  margin-bottom:1.1rem;text-align:left;
+  background:rgba(255,255,255,.02);
+}
+.csv-import-row{
+  display:flex;align-items:center;justify-content:space-between;gap:8px;
+  padding:7px 10px;font-size:12px;color:rgba(255,255,255,.8);
+  border-bottom:1px solid rgba(255,255,255,.05);
+}
+.csv-import-row:last-child{border-bottom:none}
+.csv-import-row-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.csv-import-row-del{
+  flex-shrink:0;background:none;border:none;cursor:pointer;
+  color:rgba(255,255,255,.25);font-size:13px;padding:2px 4px;line-height:1;
+  transition:color var(--transition-fast);
+}
+.csv-import-row-del:hover{color:#ff6b6b}
+.csv-import-empty-list{
+  padding:1.5rem 1rem;text-align:center;
+  font-size:11px;color:rgba(255,255,255,.25);
+}
+
+/* Stato disabilitato per i pulsanti del modal generico — non esisteva
+   ancora nessuna regola per .pp-generic-btn:disabled (puro additivo,
+   nessun rischio di conflitto con ppAlert/ppConfirmBox/ppPromptBox). */
+.pp-generic-btn:disabled{opacity:.35;cursor:default;pointer-events:none;}
+}
+
+@layer theme {
+/* ── 19. IMPORT CSV ───────────────────────────────────────────── */
+html[data-theme="light"] .csv-import-trigger-btn{
+  border-color: rgba(var(--accent-rgb),.35);
+  background: rgba(var(--accent-rgb),.05);
+  color: #00786a;
+}
+html[data-theme="light"] .csv-import-trigger-btn:hover{
+  background: rgba(var(--accent-rgb),.1);
+  border-color: rgba(var(--accent-rgb),.55);
+  color: var(--accent);
+}
+html[data-theme="light"] .csv-import-list{ background: rgba(var(--navy-rgb),.02); border-color: rgba(var(--navy-rgb),.09); }
+html[data-theme="light"] .csv-import-row{ color: rgba(var(--navy-rgb),.8); border-bottom-color: rgba(var(--navy-rgb),.06); }
+html[data-theme="light"] .csv-import-row-del{ color: rgba(var(--navy-rgb),.35); }
+html[data-theme="light"] .csv-import-empty-list{ color: rgba(var(--navy-rgb),.3); }
+
+}
diff --git a/css/dashboard.css b/css/dashboard.css
new file mode 100644
index 0000000..c75ed4c
--- /dev/null
+++ b/css/dashboard.css
@@ -0,0 +1,165 @@
+/* ===============================================
+   DASHBOARD — panoramica classe/docente
+   Estratto dal monolite pixelprof.css (redesign palette v9).
+   NOTA: l'override tema chiaro per questa sezione resta per ora
+   nel grande blocco @layer theme condiviso in pixelprof.css
+   (sezione numerata corrispondente — vedi commento lì) e non è
+   stato ancora spostato qui: la separazione dell'override chiaro
+   sezione-per-sezione è un passo successivo, non incluso in questa
+   estrazione.
+=============================================== */
+@layer dashboard {
+/* ═══════════════════════════════════════════════════════════════════
+   PixelProf v6.0.0 — DASHBOARD DIRETTORE + GESTIONE DOCENTI
+   Stile coerente con .course-card/.cat-card già presenti:
+   cinematic lift on hover, bottom accent bar, glow per categoria.
+   ═══════════════════════════════════════════════════════════════════ */
+
+#screen-director-dashboard,
+#screen-teacher-mgmt,
+#screen-teacher-create,
+#screen-teacher-list,
+#screen-teacher-detail{
+  position:fixed;inset:0;z-index:8000;
+  background:var(--surface-0);
+  background-image:
+    radial-gradient(ellipse 80% 50% at 20% 0%,rgba(var(--accent-rgb),.03) 0%,transparent 60%),
+    radial-gradient(ellipse 60% 40% at 80% 100%,rgba(var(--purple-rgb),.03) 0%,transparent 60%);
+  overflow-y:auto;display:flex;flex-direction:column;
+}
+#screen-director-dashboard.hidden,
+#screen-teacher-mgmt.hidden,
+#screen-teacher-create.hidden,
+#screen-teacher-list.hidden,
+#screen-director-dashboard.entering,
+#screen-teacher-mgmt.entering,
+#screen-teacher-create.entering,
+#screen-teacher-list.entering,
+#screen-teacher-detail.entering{ animation:screenFadeIn .35s ease both; }
+
+/* ── Griglia 3 card Dashboard Direttore ── */
+.dd-grid{
+  display:grid;grid-template-columns:1fr;gap:14px;margin-top:8px;
+}
+@media(min-width:560px){ .dd-grid{ grid-template-columns:1fr 1fr 1fr; } }
+
+.dd-card{
+  position:relative;border-radius:16px;
+  border:1px solid rgba(255,255,255,.09);
+  background:rgba(255,255,255,.04);
+  cursor:pointer;overflow:hidden;
+  box-shadow:0 4px 20px rgba(0,0,0,.35);
+  transition:transform .22s cubic-bezier(.34,1.56,.64,1),box-shadow .2s ease,border-color .2s ease,background .2s ease;
+}
+.dd-card::after{
+  content:'';position:absolute;bottom:0;left:0;right:0;height:2px;
+  transform:scaleX(0);transition:transform .22s ease;
+}
+.dd-card:hover{ transform:translateY(-4px) scale(1.02); }
+.dd-card:hover::after{ transform:scaleX(1); }
+.dd-card:focus-visible{ outline:2px solid var(--accent); outline-offset:3px; }
+
+.dd-card-inner{
+  display:flex;flex-direction:column;align-items:flex-start;gap:8px;
+  padding:1.5rem 1.25rem;min-height:140px;position:relative;
+}
+.dd-icon{
+  font-size:32px;line-height:1;
+  filter:drop-shadow(0 0 8px rgba(255,255,255,.15));
+  transition:transform .22s cubic-bezier(.34,1.56,.64,1);
+}
+.dd-card:hover .dd-icon{ transform:scale(1.14); }
+.dd-title{ font-size:16px;font-weight:700;color:#fff;transition:color .18s; }
+.dd-sub{ font-size:11px;color:rgba(255,255,255,.4);line-height:1.5;padding-right:24px; }
+.dd-arrow{
+  position:absolute;bottom:1.25rem;right:1.25rem;font-size:16px;
+  color:rgba(255,255,255,.2);transition:color .18s,transform .18s;
+}
+.dd-card:hover .dd-arrow{ transform:translateX(3px); }
+
+.dd-aule{ border-color:rgba(30,144,255,.15); }
+.dd-aule::after{ background:linear-gradient(90deg,transparent,#1e90ff,transparent); }
+.dd-aule:hover{ border-color:rgba(30,144,255,.5); box-shadow:0 12px 36px rgba(30,144,255,.14); }
+.dd-aule:hover .dd-title,.dd-aule:hover .dd-arrow{ color:#5eb8ff; }
+
+.dd-docenti{ border-color:rgba(var(--purple-rgb),.15); }
+.dd-docenti::after{ background:linear-gradient(90deg,transparent,var(--purple),transparent); }
+.dd-docenti:hover{ border-color:rgba(var(--purple-rgb),.5); box-shadow:0 12px 36px rgba(var(--purple-rgb),.14); }
+.dd-docenti:hover .dd-title,.dd-docenti:hover .dd-arrow{ color:#b4a0ff; }
+
+/* v8.26.0: rimosse le regole .dd-scegli (dead code) — la card "Scegli
+   Aula" è stata sostituita dalla fascia .dd-enter-banner, sempre
+   distinta dalle card di gestione, stile in css/director-profile.css.
+   Nuova card .dd-direttore (accento oro) anch'essa nel file dedicato. */
+
+/* ── Gestione Docenti — badge "Disattivato" (scheda docente) ──
+   v8.14.0: rimossa la famiglia .tm-list/.tm-row/.tm-row-name (vecchio
+   design a lista, mai più referenziata da JS/HTML — vedi
+   UX_AUDIT_grafica_dark_light.md §6). .tm-badge-inactive invece è
+   attivamente usata in js/app.js (tmOpenDetail, tmDetailSaveProfile,
+   tmDetailToggleActive) quindi resta e viene tematizzata sotto. */
+.tm-badge-inactive{
+  font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;
+  padding:2px 8px;border-radius:20px;flex-shrink:0;
+  background:rgba(255,80,80,.1);border:1px solid rgba(255,80,80,.3);color:#ff6b6b;
+}
+
+/* ═══════════════════════════════════════════════════════════════════
+}
+
+@layer theme {
+/* ── 14. PANORAMICA CLASSE (dashboard) ───────────────────────── */
+html[data-theme="light"] .chd-kpi-card{ background:#ffffff; border-color: rgba(var(--navy-rgb),.08); }
+html[data-theme="light"] .chd-kpi-lbl{ color: rgba(var(--navy-rgb),.45); }
+html[data-theme="light"] .chd-section-title{ color:var(--navy); }
+html[data-theme="light"] .chd-weak-card,html[data-theme="light"] .chd-part-table{ background:#ffffff; border-color: rgba(var(--navy-rgb),.08); }
+html[data-theme="light"] .chd-weak-headline{ color: rgba(var(--navy-rgb),.75); }
+html[data-theme="light"] .chd-mod-name{ color: rgba(var(--navy-rgb),.65); }
+/* .chd-mod-pct: colore impostato inline da dashboard.js in base al
+   modulo. Le classi gemelle chd-ink-* (aggiunte lì accanto allo style
+   inline esistente, una per ogni modulo — non solo CE/OE/WP) permettono
+   di sovrascrivere SOLO il testo — stessa identica logica del ruolo in
+   topbar (§3). */
+html[data-theme="light"] .chd-ink-ce{ color:#a66a00 !important; }
+html[data-theme="light"] .chd-ink-oe{ color:#6a4fd6 !important; }
+html[data-theme="light"] .chd-ink-wp{ color:#0d6fbf !important; }
+html[data-theme="light"] .chd-ink-ss{ color:#1f7a42 !important; }
+html[data-theme="light"] .chd-ink-pp{ color:#b8501f !important; }
+html[data-theme="light"] .chd-part-header{ color: rgba(var(--navy-rgb),.3); background: rgba(var(--navy-rgb),.02); }
+html[data-theme="light"] .chd-part-row{ color: rgba(var(--navy-rgb),.75); border-bottom-color: rgba(var(--navy-rgb),.06); }
+html[data-theme="light"] .chd-part-last{ color: rgba(var(--navy-rgb),.4); }
+html[data-theme="light"] .chd-act-name{ color: rgba(var(--navy-rgb),.65); }
+html[data-theme="light"] .chd-act-bar-wrap{ background: rgba(var(--navy-rgb),.07); }
+/* v8.13.1: override chd-footnote rimosso (era 2.03:1 anche in chiaro) — ora var(--text-dim) */
+/* v8.15.1: override chd-empty-title/chd-empty-sub rimossi (erano rgba(var(--navy-rgb),.4)
+   ~2.9:1 e rgba(var(--navy-rgb),.28) ~2.1:1, entrambi sotto AA anche in chiaro) — ora
+   var(--text-muted)/var(--text-dim), già tematizzati, stesso pattern di .chd-wq-tab
+   in v8.14.0. */
+/* v8.14.0: .chd-wq-tab non ha più un override qui — la regola base
+   (@layer classhealth) usa ora var(--text-muted), che cambia già
+   valore da sola in chiaro. Il vecchio override hardcoded rgba(var(--navy-rgb),.45)
+   (2.88:1) ignorava silenziosamente il token, stesso pattern già visto
+   per .logo-sub in Fase 2. */
+html[data-theme="light"] .chd-wq-tab-count{ background: rgba(var(--navy-rgb),.08); color: var(--text-muted); } /* v8.14.0 FIX: nessun override esisteva -> 1.04:1, quasi invisibile */
+html[data-theme="light"] .chd-wq-tab.active .chd-wq-tab-count{ color:inherit; }
+html[data-theme="light"] .chd-wq-tab-problem.active{ color:#c22a3e; } /* v8.14.0 FIX: #ff6b85 su chiaro = 2.50:1 */
+html[data-theme="light"] .chd-wq-tab-recovered.active{ color:#12805a; } /* v8.14.0 FIX: #00ff96 su chiaro = 1.22:1 */
+html[data-theme="light"] .chd-wq-modfilter-btn{ background:#ffffff; border-color: rgba(var(--navy-rgb),.1); color: var(--text-muted); } /* v8.14.0 FIX: era rgba(var(--navy-rgb),.5) = 3.32:1 */
+html[data-theme="light"] .chd-wq-modfilter-btn.active{ color: var(--text-primary); }
+html[data-theme="light"] .chd-wq-modfilter-count{ background: rgba(var(--navy-rgb),.08); }
+html[data-theme="light"] .chd-wq-row{ background:#ffffff; }
+html[data-theme="light"] .chd-wq-question{ color: rgba(var(--navy-rgb),.82); }
+html[data-theme="light"] .chd-wq-answer{ color: rgba(var(--navy-rgb),.45); }
+html[data-theme="light"] .chd-wq-answer strong{ color:#12805a; } /* v8.14.0 FIX: rgba(var(--accent-rgb),.75) su chiaro = 1.27:1 */
+html[data-theme="light"] .chd-wq-errs{ color:#c22a3e; } /* v8.14.0 FIX: rgba(255,80,80,.9) su chiaro = 2.64:1 */
+html[data-theme="light"] .chd-wq-list-recovered .chd-wq-errs{ color:#12805a; } /* v8.14.0 FIX: rgba(0,255,150,.8) su chiaro = 1.31:1 */
+html[data-theme="light"] .chd-wq-reset-btn{ background: rgba(194,42,62,.06); border-color: rgba(194,42,62,.25); color:#c22a3e; } /* v8.14.0 FIX: nessun override -> 1.77:1 */
+html[data-theme="light"] .chd-wq-empty{ border-color: rgba(var(--navy-rgb),.1); }
+html[data-theme="light"] .chd-wq-empty-title{ color: var(--text-muted); } /* v8.14.0 FIX: era rgba(var(--navy-rgb),.5) = 3.32:1 */
+html[data-theme="light"] .chd-wq-empty-sub{ color: var(--text-dim); } /* v8.14.0 FIX: era rgba(var(--navy-rgb),.3) = 1.93:1 */
+html[data-theme="light"] .tm-badge-inactive{ background: rgba(194,42,62,.08); border-color: rgba(194,42,62,.3); color:#c22a3e; } /* v8.14.0 FIX: #ff6b6b su chiaro = 2.55-2.78:1 */
+/* .chd-never-played: banner ambra "non ha ancora mai giocato" —
+   stesso #ffb400 su sfondo chiaro, stessa ink di riserva. */
+html[data-theme="light"] .chd-never-played{ color:#a66d00; }
+
+}
diff --git a/css/dialogs.css b/css/dialogs.css
new file mode 100644
index 0000000..76070e1
--- /dev/null
+++ b/css/dialogs.css
@@ -0,0 +1,120 @@
+/* ===============================================
+   DIALOG di conferma + generici, wizard, pannelli
+   Estratto dal monolite pixelprof.css (redesign palette v9).
+   NOTA: l'override tema chiaro per questa sezione resta per ora
+   nel grande blocco @layer theme condiviso in pixelprof.css
+   (sezione numerata corrispondente — vedi commento lì) e non è
+   stato ancora spostato qui: la separazione dell'override chiaro
+   sezione-per-sezione è un passo successivo, non incluso in questa
+   estrazione.
+=============================================== */
+@layer dialogs {
+/* ═══════════════════════════════════════════════════════════════════
+   PixelProf v6.2.0 — GENERIC THEMED DIALOGS
+   Stile per ppAlert() / ppConfirmBox() / ppPromptBox() definite in
+   game-engine-state.js. Markup creato dinamicamente da JS — questa
+   sezione è puro CSS, nessun markup statico aggiunto a index.html.
+   Sostituiscono alert()/confirm()/prompt() nativi in tutta l'app.
+   ═══════════════════════════════════════════════════════════════════ */
+.pp-generic-overlay{
+  position:fixed;inset:0;z-index:9800;
+  background:rgba(0,0,0,.72);
+  backdrop-filter:blur(10px) saturate(140%);
+  -webkit-backdrop-filter:blur(10px) saturate(140%);
+  display:flex;align-items:center;justify-content:center;
+  padding:1rem;
+  animation:ppGenericFadeIn .18s ease both;
+}
+@keyframes ppGenericFadeIn{from{opacity:0;}to{opacity:1;}}
+.pp-generic-box{
+  background:#0a1022;
+  border:1px solid rgba(var(--accent-rgb),.18);
+  border-radius:var(--radius-lg);
+  padding:1.5rem;
+  width:100%;max-width:340px;
+  box-shadow:0 20px 70px rgba(0,0,0,.75),0 0 0 1px rgba(var(--accent-rgb),.06);
+  animation:dropIn .2s cubic-bezier(.22,1,.36,1) both;
+  text-align:center;
+}
+.pp-generic-icon{font-size:30px;margin-bottom:10px;line-height:1}
+.pp-generic-title{font-size:15px;font-weight:700;color:#fff;margin-bottom:6px}
+.pp-generic-msg{font-size:12px;color:rgba(255,255,255,.45);line-height:1.55;margin-bottom:1.1rem}
+.pp-generic-input{
+  width:100%;padding:9px 12px;margin-bottom:1.1rem;
+  border-radius:var(--radius-sm);border:1px solid var(--border-mid);
+  background:rgba(255,255,255,.05);color:var(--text-primary);
+  font-size:13px;font-family:inherit;outline:none;text-align:left;
+  transition:border var(--transition-fast),box-shadow var(--transition-fast);
+}
+.pp-generic-input:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(var(--accent-rgb),.08);}
+.pp-generic-btns{display:flex;gap:8px}
+.pp-generic-btn{
+  flex:1;padding:10px;border-radius:var(--radius-sm);border:1px solid;
+  font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;
+  transition:all var(--transition-fast);position:relative;overflow:hidden;
+}
+.pp-generic-btn::after{
+  content:'';position:absolute;bottom:0;left:0;right:0;height:1.5px;
+  transform:scaleX(0);transition:transform var(--transition-fast);
+}
+.pp-generic-btn:hover::after{transform:scaleX(1);}
+.pp-generic-btn.cancel{
+  background:var(--surface-1);border-color:var(--border-mid);color:rgba(255,255,255,.6);
+}
+.pp-generic-btn.cancel::after{background:rgba(255,255,255,.3);}
+.pp-generic-btn.cancel:hover{background:var(--surface-2);color:#fff;}
+.pp-generic-btn.ok,
+.pp-generic-btn.confirm{
+  background:var(--accent-dim);border-color:var(--accent);color:var(--accent);
+}
+.pp-generic-btn.ok::after,
+.pp-generic-btn.confirm::after{background:var(--accent);}
+.pp-generic-btn.ok:hover,
+.pp-generic-btn.confirm:hover{background:rgba(var(--accent-rgb),.22);}
+.pp-generic-btn.confirm.danger{
+  background:rgba(255,60,80,.12);border-color:rgba(255,60,80,.4);color:#ff4d6d;
+}
+.pp-generic-btn.confirm.danger::after{background:#ff4d6d;}
+.pp-generic-btn.confirm.danger:hover{background:rgba(255,60,80,.2);}
+}
+
+@layer theme {
+/* ── 17. DIALOG (conferma + generici) + WIZARD + PANNELLI ────── */
+html[data-theme="light"] .pp-dialog-overlay,html[data-theme="light"] .pp-generic-overlay{ background: rgba(var(--navy-rgb),.35); }
+html[data-theme="light"] .pp-dialog,html[data-theme="light"] .pp-generic-box{ background:#ffffff; border-color: rgba(var(--navy-rgb),.1); }
+html[data-theme="light"] .pp-dialog-title,html[data-theme="light"] .pp-generic-title{ color:var(--navy); }
+html[data-theme="light"] .pp-dialog-sub,html[data-theme="light"] .pp-generic-msg{ color: rgba(var(--navy-rgb),.5); }
+html[data-theme="light"] .pp-dialog-btn.cancel,html[data-theme="light"] .pp-generic-btn.cancel{ background: rgba(var(--navy-rgb),.05); color: rgba(var(--navy-rgb),.6); }
+html[data-theme="light"] .cw-box,html[data-theme="light"] .dp-box,html[data-theme="light"] .icon-picker-box{ background:#ffffff; border-color: rgba(var(--navy-rgb),.12); }
+html[data-theme="light"] .cw-title,html[data-theme="light"] .dp-title,html[data-theme="light"] .icp-title{ color:var(--navy); }
+html[data-theme="light"] .cw-subtitle{ color: rgba(var(--navy-rgb),.45); }
+html[data-theme="light"] .cw-mod-btn,html[data-theme="light"] .cw-teacher-row,html[data-theme="light"] .dp-teacher-row{ background: rgba(var(--navy-rgb),.03); border-color: rgba(var(--navy-rgb),.09); }
+html[data-theme="light"] .cw-mod-btn .cm-name{ color:var(--navy); }
+html[data-theme="light"] .cw-mod-btn .cm-desc{ color: rgba(var(--navy-rgb),.4); }
+html[data-theme="light"] .cw-teacher-row .ct-name{ color: rgba(var(--navy-rgb),.75); }
+html[data-theme="light"] .cw-teacher-row .ct-email{ color: rgba(var(--navy-rgb),.35); }
+/* .cw-warn-banner: stessa ink ambra di riserva usata per timer-pill/chd-never-played */
+html[data-theme="light"] .cw-warn-banner{ color:#a66d00; }
+/* .dp-teacher-row: bg/border-color erano già coperti sopra (riga
+   raggruppata con .cw-mod-btn/.cw-teacher-row), ma non il colore
+   testo — restava rgba(255,255,255,.7), quasi invisibile sul
+   fondo ormai chiaro di .dp-box. */
+html[data-theme="light"] .dp-teacher-row{ color: rgba(var(--navy-rgb),.75); }
+/* .dp-close-btn: "×" del pannello "⚙️ Gestione aula" — invisibile sia
+   a riposo (rgba(255,255,255,.35)) sia in hover (#fff), stesso tipo
+   di difetto segnalato per la scheda docente. */
+html[data-theme="light"] .dp-close-btn{ color: rgba(var(--navy-rgb),.4); }
+html[data-theme="light"] .dp-close-btn:hover{ color:var(--navy); }
+html[data-theme="light"] .icp-close{ color: rgba(var(--navy-rgb),.55); }
+html[data-theme="light"] .icp-close:hover{ border-color: rgba(var(--navy-rgb),.2); color:var(--navy); }
+html[data-theme="light"] .icp-x-close{ color: rgba(var(--navy-rgb),.35); }
+html[data-theme="light"] .icp-x-close:hover{ color:var(--navy); }
+/* .mod-toggle-btn (moduli abilitati, pannello Gestione aula): stato
+   attivo/hover già usano var(--accent) e si adattano da soli; solo lo
+   stato di riposo era hardcoded rgba(255,255,255,.5). */
+html[data-theme="light"] .mod-toggle-btn{ color: rgba(var(--navy-rgb),.55); }
+html[data-theme="light"] .course-dropdown{ background:#ffffff; border-color: rgba(var(--navy-rgb),.1); }
+html[data-theme="light"] .cd-item{ color: rgba(var(--navy-rgb),.7); }
+html[data-theme="light"] .cd-item:hover{ background: rgba(var(--navy-rgb),.06); color:var(--navy); }
+
+}
