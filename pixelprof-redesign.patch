+/* .dd-arrow: freccia "›" sulle card Dashboard Direttore/Gestione
+   Docenti — rgba(255,255,255,.2) è quasi invisibile su sfondo bianco. */
+html[data-theme="light"] .dd-arrow{ color: rgba(var(--navy-rgb),.25); }
+/* .tdc-aula-toggle-btn — BUG ESPLICITO SEGNALATO: le aule NON
+   selezionate nella scheda docente usavano testo bianco translucido,
+   praticamente invisibile sul fondo ormai chiaro di .tdc-card /
+   .setup-card. Lo stato .active usa già var(--accent) e si adatta da
+   solo, qui serviva solo il default + hover. */
+html[data-theme="light"] .tdc-aula-toggle-btn{ color: rgba(var(--navy-rgb),.55); }
+html[data-theme="light"] .tdc-aula-toggle-btn:hover{ color: rgba(var(--navy-rgb),.85); }
+/* Chip "aule assegnate" nella card della lista docenti (screen-teacher-list) */
+/* v8.15.2: .tdc-aula-chip/.tdc-aule-empty non hanno più bisogno di override
+   qui — ora usano var(--text-muted)/var(--text-dim), già tematizzati. */
+html[data-theme="light"] .tdc-aula-chip + .tdc-aula-chip::before{ color: rgba(var(--navy-rgb),.22); }
+/* v8.15.2: compensazione opacità composta per .tdc-card.tdc-inactive{opacity:.55}
+   in tema chiaro — stesso problema e stessa soluzione scoped del tema scuro
+   (vedi @layer classhealth ~riga 4066). */
+html[data-theme="light"] .tdc-card.tdc-inactive .tdc-email,
+html[data-theme="light"] .tdc-card.tdc-inactive .tdc-aula-chip,
+html[data-theme="light"] .tdc-card.tdc-inactive .tdc-aule-empty{ color: rgba(var(--navy-rgb),.85); } /* effettivo ×.55 ≈ .4675, ≈ soglia --text-dim (.47) */
+/* Icona genere di default (nessun genere impostato, fallback ti-user) */
+html[data-theme="light"] .tdc-gender-icon{ background: rgba(var(--navy-rgb),.05); border-color: rgba(var(--navy-rgb),.12); color: rgba(var(--navy-rgb),.4); }
+html[data-theme="light"] .tmd-email-hint{ color: rgba(var(--navy-rgb),.4); }
+html[data-theme="light"] .dp-hint-text{ color: rgba(var(--navy-rgb),.35); }
+
+}
