-/* ═══════════════════════════════════════════════════════════════════
-   PixelProf — SKELETON LOADING (5 minigiochi) — v1.0.0
-   Sostituisce lo spinner pulsante generico (icona+testo+path, vedi
-   game-engine-state.js) con scheletri che ricalcano la geometria
-   reale di ciascun minigioco: percezione di velocità migliore,
-   soprattutto su PC di laboratorio non recentissimi, e nessun salto
-   di layout quando il contenuto vero arriva. Usa i token esistenti
-   (--surface-1, --border-subtle, --radius-*) quindi è già coerente
-   con entrambi i temi chiaro/scuro senza bisogno di override
-   dedicati nel layer "theme" — solo lo shimmer stesso usa 2 nuovi
-   token (--skel-c1/--skel-c2) per restare leggibile su sfondo chiaro.
-   ═══════════════════════════════════════════════════════════════════ */
-:root{
-  --skel-c1: rgba(255,255,255,.05);
-  --skel-c2: rgba(255,255,255,.12);
-}
-@keyframes skelShimmer{
-  0%   { background-position:-150% 0; }
-  100% { background-position: 150% 0; }
-}
-@keyframes skelFadeIn{ from{opacity:0} to{opacity:1} }
-
-.skel-wrap{ animation:skelFadeIn .25s ease both; }
-
-.skel-base{
-  background:linear-gradient(90deg,var(--skel-c1) 25%,var(--skel-c2) 50%,var(--skel-c1) 75%);
-  background-size:200% 100%;
-  animation:skelShimmer 1.5s ease-in-out infinite;
-  border-radius:8px;
-}
-/* stagger ciclico ogni 6 elementi — copre sia le liste corte (4 opzioni,
-   4 chip) sia quelle lunghe (12 carte Memory) con un solo set di regole */
-.skel-base:nth-child(6n+1){ animation-delay:0s; }
