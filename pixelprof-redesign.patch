diff --git a/css/loaders.css b/css/loaders.css
new file mode 100644
index 0000000..4cb24c7
--- /dev/null
+++ b/css/loaders.css
@@ -0,0 +1,84 @@
+/* ===============================================
+   LOADER / SKELETON
+   Estratto dal monolite pixelprof.css (redesign palette v9).
+   NOTA: l'override tema chiaro per questa sezione resta per ora
+   nel grande blocco @layer theme condiviso in pixelprof.css
+   (sezione numerata corrispondente — vedi commento lì) e non è
+   stato ancora spostato qui: la separazione dell'override chiaro
+   sezione-per-sezione è un passo successivo, non incluso in questa
+   estrazione.
+=============================================== */
+@layer loaders {
+/* ═══════════════════════════════════════════════════════════════════
+   PixelProf — SKELETON LOADING (5 minigiochi) — v1.0.0
+   Sostituisce lo spinner pulsante generico (icona+testo+path, vedi
+   game-engine-state.js) con scheletri che ricalcano la geometria
+   reale di ciascun minigioco: percezione di velocità migliore,
+   soprattutto su PC di laboratorio non recentissimi, e nessun salto
+   di layout quando il contenuto vero arriva. Usa i token esistenti
+   (--surface-1, --border-subtle, --radius-*) quindi è già coerente
+   con entrambi i temi chiaro/scuro senza bisogno di override
+   dedicati nel layer "theme" — solo lo shimmer stesso usa 2 nuovi
+   token (--skel-c1/--skel-c2) per restare leggibile su sfondo chiaro.
+   ═══════════════════════════════════════════════════════════════════ */
+:root{
+  --skel-c1: rgba(255,255,255,.05);
+  --skel-c2: rgba(255,255,255,.12);
+}
+@keyframes skelShimmer{
+  0%   { background-position:-150% 0; }
+  100% { background-position: 150% 0; }
+}
+@keyframes skelFadeIn{ from{opacity:0} to{opacity:1} }
+
+.skel-wrap{ animation:skelFadeIn .25s ease both; }
+
+.skel-base{
+  background:linear-gradient(90deg,var(--skel-c1) 25%,var(--skel-c2) 50%,var(--skel-c1) 75%);
+  background-size:200% 100%;
+  animation:skelShimmer 1.5s ease-in-out infinite;
+  border-radius:8px;
+}
+/* stagger ciclico ogni 6 elementi — copre sia le liste corte (4 opzioni,
+   4 chip) sia quelle lunghe (12 carte Memory) con un solo set di regole */
+.skel-base:nth-child(6n+1){ animation-delay:0s; }
+.skel-base:nth-child(6n+2){ animation-delay:.08s; }
+.skel-base:nth-child(6n+3){ animation-delay:.16s; }
+.skel-base:nth-child(6n+4){ animation-delay:.24s; }
+.skel-base:nth-child(6n+5){ animation-delay:.32s; }
+.skel-base:nth-child(6n)  { animation-delay:.4s; }
+
+.skel-row{ display:flex;gap:8px;margin-bottom:12px;flex-wrap:wrap; }
+.skel-pill{ height:26px;width:64px;border-radius:20px; }
+
+.skel-bar{ height:8px;border-radius:4px;margin-bottom:14px; }
+.skel-progress{ height:3px; }
+
+.skel-card{
+  background:var(--surface-1);
+  border:1px solid var(--border-subtle);
+  border-radius:var(--radius-md);
+  padding:1.25rem;
+  margin-bottom:10px;
+}
+.skel-line{ height:14px;border-radius:6px;margin-bottom:10px; }
+.skel-line:last-child{ margin-bottom:0; }
+.skel-line-cat{ width:38%;height:9px; }
+.skel-line-q1{ width:92%; }
+.skel-line-q2{ width:64%; }
+.skel-line-sentence{ width:100%;height:22px;margin-bottom:0; }
+
+.skel-opts{ display:flex;flex-direction:column;gap:7px; }
+.skel-opt{ height:42px;border-radius:var(--radius-sm); }
+
+.skel-match-cols{ display:grid;grid-template-columns:1fr 1fr;gap:10px; }
+.skel-item{ height:34px;border-radius:var(--radius-sm);margin-bottom:5px; }
+
+.skel-mem-board{ display:grid;grid-template-columns:repeat(4,1fr);gap:8px; }
+.skel-mem-card{ aspect-ratio:1;border-radius:var(--radius-md); }
+
+.skel-chips{ display:flex;flex-wrap:wrap;gap:6px;margin-bottom:10px; }
+.skel-chip{ height:28px;width:74px;border-radius:20px; }
+
+.skel-btn{ height:40px;width:160px;border-radius:var(--radius-sm); }
+}
